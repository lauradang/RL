flowchart TB
  FE["<b>Dynamo frontend</b> ← HTTP from SingleController (VllmGeneration)<br/>picks ONE engine by KV overlap · engines register via etcd"]
  subgraph DW["<b>ONE DYNAMO WORKER</b> (e.g. vLLM shard 0) = one DP-leader Ray actor"]
    direction TB
    subgraph ACT["VllmAsyncGenerationWorkerImpl · NeMo RL Ray actor · one asyncio loop"]
      direction TB
      WK["<b>dynamo.common.backend.Worker</b><br/>task on the actor loop · receives requests"]
      NE["★ <b>DynamoVllmAdapter</b> (LLMEngine)<br/>vLLM half of the shared <b>DynamoEngineAdapter</b><br/>(was NativeVllmEngine) · in-process"]
      LLM["<b>AsyncLLM</b> · vLLM engine<br/>refit / pause / sleep are the worker's own"]
      WK -- "generate(request)" --> NE
      NE -- "serve_rollout() → _serve_rollout()" --> LLM
    end
    subgraph TP["vLLM's own TP×PP executor workers (GPU 1..N-1)"]
      direction LR
      G1["GPU 1"] ~~~ GN["GPU N-1"]
    end
  end
  FE == "request" ==> WK
  LLM -- "vLLM multiproc / Ray executor" --> TP
  GONE["<s>coordinator · InferenceClient ① ② · sidecar actor</s><br/>no separate control process: pause/resume are actor methods on the same loop"]
  style DW fill:#e4f2f7,stroke:#2a7b9b
  style FE fill:#e4f2f7,stroke:#2a7b9b
  style ACT fill:#fdeee9,stroke:#d94f30
  style TP fill:#ffffff,stroke:#d94f30
  style WK fill:#e4f2f7,stroke:#2a7b9b
  style NE fill:#e6f4ea,stroke:#c2185b,stroke-width:4px
  style LLM fill:#fdf5e0,stroke:#d4a843
  style G1 fill:#fdf5e0,stroke:#d4a843
  style GN fill:#fdf5e0,stroke:#d4a843
  style GONE fill:#f2f2f2,stroke:#9e9e9e,stroke-dasharray: 5 5,color:#777
