digraph token_capture_flow {
  graph [
    rankdir=TB,
    bgcolor="#fbfbfd",
    pad="0.35",
    nodesep="0.6",
    ranksep="0.65",
    fontname="Helvetica",
    labelloc="t",
    label="Token capture custody — Megatron and vLLM",
    fontsize=24
  ];

  node [
    shape=box,
    style="rounded,filled",
    fillcolor="white",
    color="#475569",
    fontname="Helvetica",
    fontsize=10,
    margin="0.16,0.11"
  ];
  edge [color="#475569", fontname="Helvetica", fontsize=9];

  gym_request [
    color="#2563eb",
    fillcolor="#dbeafe",
    label="GYM ADMITS THE CALL\nCaptureAdmission carries rollout/call/parent identity,\nmode, prev_len, staging_chain, and parent_chain_hash"
  ];

  minf_frontend [
    group="left",
    color="#ea580c",
    fillcolor="#ffedd5",
    label="MInf HTTP FRONTEND\nApply the Megatron chat template, identify the new-turn suffix,\nand forward CaptureAdmission plus splice metadata"
  ];
  megatron_prepare [
    group="left",
    color="#ea580c",
    fillcolor="#ffedd5",
    label="MEGATRON MP COORDINATOR\nTQMegatronPromptPreparer resolves staging_chain from TQ,\nbuilds exact parent tokens + rendered suffix, and broadcasts the request"
  ];
  vllm_prepare [
    group="right",
    color="#7c3aed",
    fillcolor="#ede9fe",
    label="vLLM WORKER\nResolve staging_chain from TQ and build the exact prompt\nfrom the worker capture request"
  ];

  megatron_generate [
    group="left",
    color="#ea580c",
    fillcolor="#ffedd5",
    label="MEGATRON GENERATES\nThe internal finished-request payload exposes exact prompt tokens,\ngenerated tokens/logprobs, and policy_epoch to the capture hook"
  ];
  vllm_generate [
    group="right",
    color="#7c3aed",
    fillcolor="#ede9fe",
    label="vLLM GENERATES\nThe public response supplies generated tokens/logprobs; the worker\nretains exact preprocessing-time prompt tokens and weight version"
  ];

  megatron_capture [
    group="left",
    color="#ea580c",
    fillcolor="#ffedd5",
    label="TQMegatronTokenStager\nRolloutTokenCapture computes the canonical delta,\ndigests, hashes, and commit coordinates"
  ];
  vllm_capture [
    group="right",
    color="#7c3aed",
    fillcolor="#ede9fe",
    label="vLLM TOKEN CAPTURE\nRolloutTokenCapture computes the canonical delta,\ndigests, hashes, and commit coordinates"
  ];

  tq_staging [
    shape=cylinder,
    color="#0f766e",
    fillcolor="#99f6e4",
    penwidth=2,
    label="TQ STAGING\nCanonical StagedCallRecord under a staging_key derived from rollout/call:\ntoken_ids_delta, token_mask_delta, generation_logprobs_delta,\nidentity, lengths, weight_version, digests, chain hashes, and optional extras"
  ];

  gym_commit [
    color="#2563eb",
    fillcolor="#dbeafe",
    label="SUCCESS: GYM COMMITS AFTER TQ ACK\nThe backend returns ng_commit_coords. Gym verifies them, writes a\ntoken-free CallRecord, strips capture fields, then serves the response"
  ];

  capture_failure [
    color="#b91c1c",
    fillcolor="#fee2e2",
    label="CAPTURE FAILURE\nWithout valid commit coordinates Gym records a failure, not a CallRecord.\nThe model response may still be served; finalization rejects/masks the rollout"
  ];

  agent [
    color="#16a34a",
    fillcolor="#dcfce7",
    label="AGENT RECEIVES RESPONSE\nNo private token or capture fields"
  ];

  receipt [
    color="#2563eb",
    fillcolor="#dbeafe",
    label="ROLLOUT END\nNeMoGym reads committed CallRecords from Gym\nand builds one token-free RolloutReceipt.manifest"
  ];

  finalizer [
    color="#0369a1",
    fillcolor="#e0f2fe",
    label="BLACKBOX FINALIZER\nFetch canonical rows by manifest staging_key, verify digests\nand lineage, linearize the terminal chain, and attach reward"
  ];

  tq_replay [
    shape=cylinder,
    color="#0369a1",
    fillcolor="#bae6fd",
    penwidth=2,
    label="TQ REPLAY\nCanonical training sample ready for GRPO"
  ];

  vllm_api_gap [
    shape=note,
    style="filled,dashed",
    color="#b45309",
    fillcolor="#fef3c7",
    label="CURRENT API GAP\nvLLM passes prefix_token_ids to Gym begin_call(),\nbut the active Gym API does not accept that argument"
  ];

  gym_request -> minf_frontend [label="Megatron"];
  gym_request -> vllm_prepare [label="vLLM"];
  minf_frontend -> megatron_prepare;
  megatron_prepare -> megatron_generate;
  vllm_prepare -> vllm_generate;
  megatron_generate -> megatron_capture;
  vllm_generate -> vllm_capture;
  megatron_capture -> tq_staging [label="stage and wait"];
  vllm_capture -> tq_staging [label="stage and wait"];
  megatron_capture -> capture_failure [label="stage/metadata failure", style=dashed, color="#b91c1c"];
  vllm_capture -> capture_failure [label="stage/capture failure", style=dashed, color="#b91c1c"];
  tq_staging -> gym_commit [label="ng_commit_coords"];
  gym_commit -> agent;
  capture_failure -> agent [label="clean model response may continue", style=dashed, color="#b91c1c"];
  agent -> receipt;
  receipt -> finalizer;
  finalizer -> tq_staging [label="fetch by staging_key", dir=back];
  finalizer -> tq_replay;
  vllm_api_gap -> vllm_prepare [style=dashed, color="#b45309", arrowhead=none];

  { rank=same; minf_frontend; vllm_prepare; }
  { rank=same; megatron_generate; vllm_generate; }
  { rank=same; megatron_capture; vllm_capture; }
}
