digraph token_capture_flow {
  graph [
    rankdir=TB,
    bgcolor="#fbfbfd",
    pad="0.35",
    nodesep="0.6",
    ranksep="0.65",
    fontname="Helvetica",
    labelloc="t",
    label="Token capture custody — Megatron and vLLM",
    fontsize=24
  ];

  node [
    shape=box,
    style="rounded,filled",
    fillcolor="white",
    color="#475569",
    fontname="Helvetica",
    fontsize=10,
    margin="0.16,0.11"
  ];
  edge [color="#475569", fontname="Helvetica", fontsize=9];

  gym_request [
    color="#2563eb",
    fillcolor="#dbeafe",
    label="GYM ADMITS THE CALL\nCaptureAdmission carries rollout/call/parent identity,\nmode, prev_len, staging_chain, and parent_chain_hash"
  ];

  megatron_prepare [
    group="left",
    color="#ea580c",
    fillcolor="#ffedd5",
    label="MEGATRON COORDINATOR\nResolve staging_chain from TQ, build the exact prompt,\nand send CaptureAdmission as opaque request metadata"
  ];
  vllm_prepare [
    group="right",
    color="#7c3aed",
    fillcolor="#ede9fe",
    label="vLLM WORKER\nResolve staging_chain from TQ and build the exact prompt\nfrom the worker capture request"
  ];

  megatron_generate [
    group="left",
    color="#ea580c",
    fillcolor="#ffedd5",
    label="MInf GENERATES\nReturns exact prompt tokens, generated tokens,\ngenerated logprobs, and policy weight version"
  ];
  vllm_generate [
    group="right",
    color="#7c3aed",
    fillcolor="#ede9fe",
    label="vLLM GENERATES\nReturns exact prompt tokens, generated tokens,\ngenerated logprobs, and policy weight version"
  ];

  megatron_capture [
    group="left",
    color="#ea580c",
    fillcolor="#ffedd5",
    label="TQMegatronTokenStager\nRolloutTokenCapture computes the canonical delta,\ndigests, hashes, and commit coordinates"
  ];
  vllm_capture [
    group="right",
    color="#7c3aed",
    fillcolor="#ede9fe",
    label="vLLM TOKEN CAPTURE\nRolloutTokenCapture computes the canonical delta,\ndigests, hashes, and commit coordinates"
  ];

  tq_staging [
    shape=cylinder,
    color="#0f766e",
    fillcolor="#99f6e4",
    penwidth=2,
    label="TQ STAGING\nCanonical StagedCallRecord keyed by rollout_id/model_call_id:\ntoken_ids_delta, token_mask_delta, generation_logprobs_delta,\nidentity, lengths, weight_version, digests, and chain hashes"
  ];

  gym_commit [
    color="#2563eb",
    fillcolor="#dbeafe",
    label="GYM COMMITS AFTER TQ ACK\nEach backend returns ng_commit_coords. Gym writes the same\ntoken-free CallRecord to its lineage ledger, strips capture fields,\nand only then returns the response to the agent."
  ];

  agent [
    color="#16a34a",
    fillcolor="#dcfce7",
    label="AGENT RECEIVES RESPONSE\nNo private token or capture fields"
  ];

  receipt [
    color="#2563eb",
    fillcolor="#dbeafe",
    label="ROLLOUT END\nNeMoGym reads committed CallRecords from Gym\nand builds one token-free RolloutReceipt.manifest"
  ];

  finalizer [
    color="#0369a1",
    fillcolor="#e0f2fe",
    label="BLACKBOX FINALIZER\nFetch canonical rows by manifest staging_key, verify digests\nand lineage, linearize the terminal chain, and attach reward"
  ];

  tq_replay [
    shape=cylinder,
    color="#0369a1",
    fillcolor="#bae6fd",
    penwidth=2,
    label="TQ REPLAY\nCanonical training sample ready for GRPO"
  ];

  gym_request -> megatron_prepare [label="Megatron"];
  gym_request -> vllm_prepare [label="vLLM"];
  megatron_prepare -> megatron_generate;
  vllm_prepare -> vllm_generate;
  megatron_generate -> megatron_capture;
  vllm_generate -> vllm_capture;
  megatron_capture -> tq_staging [label="stage and wait"];
  vllm_capture -> tq_staging [label="stage and wait"];
  tq_staging -> gym_commit [label="ng_commit_coords"];
  gym_commit -> agent;
  agent -> receipt;
  receipt -> finalizer;
  finalizer -> tq_staging [label="fetch by staging_key", dir=back];
  finalizer -> tq_replay;

  { rank=same; megatron_prepare; vllm_prepare; }
  { rank=same; megatron_generate; vllm_generate; }
  { rank=same; megatron_capture; vllm_capture; }
}
